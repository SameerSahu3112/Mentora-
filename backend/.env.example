# Mentora Backend Environment Variables
# Copy to .env and fill in production values. Never commit real secrets.

# Application
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://mentora:mentora@localhost:5432/mentora

# Redis (optional cache)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Security
SECRET_KEY=change-me-in-production-securely
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
